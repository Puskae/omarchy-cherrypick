// Waybar in the Omarchy spirit: flat, quiet, no rounded corners.
// Omarchy 4.0 itself ships `herdr` rather than waybar, so this is an
// interpretation of its look, not a copy of an upstream file.
//
// Colors live in colors.css, regenerated by `omarchy-theme <name>`.
{
  "layer": "top",
  "position": "top",
  "height": 26,
  "spacing": 0,

  "modules-left": ["custom/menu", "custom/newworkspace", "hyprland/workspaces", "hyprland/submap"],
  "modules-center": ["clock"],
  "modules-right": [
    "custom/screenshot",
    "custom/clipboard",
    "tray",
    "custom/media",
    "custom/brightness",
    "pulseaudio",
    "bluetooth",
    "network",
    "custom/tailscale",
    "custom/notification",
    "cpu",
    "memory",
    "custom/power"
  ],

  // Omarchy puts a logo button at the far left of its bar that opens the menu.
  // That menu is a Quickshell component and isn't here, so this opens walker --
  // the same thing SUPER + SPACE does. walker's own close_when_open makes a
  // second click dismiss it.
  //
  // The glyph is the generic "apps" grid rather than Omarchy's logo: this repo
  // is not affiliated with Omarchy and should not ship its mark. Swap in 󰣇
  // (Arch) or anything else your Nerd Font has.
  "custom/menu": {
    "format": "󰀻",
    "tooltip-format": "Launcher (SUPER + SPACE)",
    "on-click": "walker"
  },

  // A mouse-reachable "give me a fresh workspace". Sits between the launcher
  // and the workspace row because that is where the workspace it creates will
  // appear.
  //
  // "empty" is a Hyprland workspace selector, not a name: it resolves to the
  // lowest-numbered workspace with no windows on it, scanning up from 1. So
  // with 1, 2, 4 and 5 in use this lands on 3, and Hyprland creates the
  // workspace on the spot -- there is nothing to pre-declare.
  //
  // Lua dispatcher form. Hyprland 0.56 parses dispatches as Lua, so the old
  // "hyprctl dispatch workspace empty" is a syntax error that fails silently
  // from a bar button. Switching workspaces is hl.dsp.focus{}, not
  // hl.dsp.workspace{} -- the latter is a table of workspace *operations*
  // (move, rename, toggle_special) and calling it raises.
  "custom/newworkspace": {
    "format": "+",
    "tooltip-format": "New empty workspace",
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"empty\" })'"
  },

  "hyprland/workspaces": {
    // No "on-click" here: that's a sway/workspaces option. On
    // hyprland/workspaces waybar would run it as a shell command and
    // swallow the built-in click-to-switch -- and the built-in handler is
    // the one you want, because it knows which button was clicked.
    //
    // Click-to-switch works on this box. It does NOT work on a
    // distro-packaged waybar 0.15.0, which hardcodes the pre-Lua
    // "dispatch workspace <id>" string that Hyprland 0.56's Lua dispatcher
    // rejects; the error goes back over IPC and is never surfaced, so the
    // click just looks ignored. Alexays/Waybar#5013 taught the module the
    // Lua form, and waybar-git carries it -- installed here 2026-09-06,
    // currently 0.15.0.r1004.g6d60c8e. Nothing in this file fixes it on an
    // older waybar; see the README. Scroll below and SUPER+1..9 work either
    // way, because those are config strings in the Lua form already.
    "format": "{id}",
    // Scroll the bar to move between workspaces, matching SUPER+scroll.
    // Hyprland 0.56 dispatchers are Lua: the old "dispatch workspace e+1"
    // string is a syntax error and fails silently from waybar.
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'"
  },

  // Screenshot, mirroring the PRINT binds so the two cannot drift: left is
  // region-to-clipboard (PRINT), right is region-to-file (SUPER + PRINT),
  // middle is whole-screen-to-clipboard (SHIFT + PRINT). Selecting a region is
  // already a mouse job, so having to reach for a key to *start* one was the
  // odd part.
  //
  // The file path goes through xdg-user-dir: the real directory on this box is
  // ~/Kuvat, and hardcoding ~/Pictures silently creates a second, English one
  // next to it.
  "custom/screenshot": {
    "format": "󰹑",
    "tooltip-format": "Screenshot region (right: to file, middle: whole screen)",
    "on-click": "grim -g \"$(slurp)\" - | wl-copy",
    "on-click-right": "d=$(xdg-user-dir PICTURES 2>/dev/null || echo \"$HOME/Pictures\"); mkdir -p \"$d\" && grim -g \"$(slurp)\" \"$d/$(date +%Y%m%d-%H%M%S).png\"",
    "on-click-middle": "grim - | wl-copy"
  },

  // Clipboard history, the same walker module SUPER + V opens. walker is named
  // literally here rather than read from profile.lua -- this is JSON, it cannot
  // see the Lua config -- so a launcher swap is a two-file change.
  "custom/clipboard": {
    "format": "󰅌",
    "tooltip-format": "Clipboard history (SUPER + V)",
    "on-click": "walker -m clipboard"
  },

  "hyprland/submap": {
    "format": "{}",
    "tooltip": false
  },

  "clock": {
    // Finnish conventions: 24h clock, Monday-first calendar, week numbers.
    "format": "{:%a %d.%m.  %H:%M}",
    // The calendar hex values below are deliberate, not an oversight: this is
    // Pango markup inside a tooltip, which cannot read colors.css, so these
    // are the one part of the bar a theme switch does not repaint.
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "left",
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b>{}</b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  "cpu": {
    "interval": 5,
    "format": "󰻠 {usage}%",
    "states": { "warning": 70, "critical": 90 },
    "tooltip": true,
    "on-click": "alacritty -e btop"
  },

  "memory": {
    "interval": 5,
    "format": "󰍛 {percentage}%",
    "states": { "warning": 75, "critical": 92 },
    "tooltip-format": "{used:0.1f}G / {total:0.1f}G",
    "on-click": "alacritty -e btop"
  },

  "network": {
    "format-wifi": "󰤨 {essid}",
    "format-ethernet": "󰈀",
    "format-linked": "󰈀 {ifname}",
    "format-disconnected": "󰤭",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
    "tooltip-format-disconnected": "Disconnected",
    // Replaces nm-applet, which was never installed.
    "on-click": "alacritty --title nmtui -e nmtui"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
    "scroll-step": 5,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol"
  },

  "custom/media": {
    "format": "󰎈 {}",
    "escape": true,
    "max-length": 40,
    "interval": 5,
    "exec": "playerctl metadata --format '{{artist}} - {{title}}' 2>/dev/null || true",
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "tooltip": false
  },

  // Monitor brightness over DDC/CI. This is a desktop: there is no
  // /sys/class/backlight and brightnessctl has nothing to talk to, so the
  // control lives on the monitor's I2C bus and ddcutil drives it.
  //
  // A DDC read costs about a second, which is far too slow to poll, so the
  // module is read "once" and then refreshed only when hypr-brightness signals
  // it -- SIGRTMIN+8, matching WAYBAR_SIGNAL in the script.
  //
  // The module disappears on a machine with no DDC/CI monitor, because
  // hypr-brightness exits non-zero and prints nothing.
  "custom/brightness": {
    "format": "󰃟 {}%",
    "exec": "hypr-brightness get",
    "interval": "once",
    "signal": 8,
    "on-scroll-up": "hypr-brightness up",
    "on-scroll-down": "hypr-brightness down",
    // Re-reads from the monitor, for when its own buttons have been used.
    "on-click": "hypr-brightness sync",
    "tooltip": false
  },

  // Built into waybar (it speaks to bluez over D-Bus), so nothing to install
  // beyond bluez/bluez-utils, which are already required for the adapter.
  //
  // blueman is not in the package list -- there is no GUI here by default, so
  // the click falls back to bluetoothctl in a terminal. Install blueman or
  // overskride if you want a real panel and the first branch will win.
  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format": "{controller_alias}\n{status}",
    "tooltip-format-connected": "{controller_alias}\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}  {device_address}",
    "on-click": "blueman-manager 2>/dev/null || alacritty --title bluetooth -e bluetoothctl"
  },

  // Read-only: `tailscale up`/`down` need root unless an operator is set
  // (`sudo tailscale set --operator=$USER`), and a bar button that pops a
  // password prompt on a stray click is worse than one that just reports.
  // Status is cheap -- a few milliseconds -- so 30s polling costs nothing.
  "custom/tailscale": {
    "format": "{}",
    "return-type": "json",
    "interval": 30,
    "exec": "hypr-tailscale",
    "on-click": "alacritty --title tailscale -e sh -c 'hypr-tailscale peers; echo; printf \"[enter] \"; read _'"
  },

  // swaync's own waybar recipe: -swb streams a JSON line on every add/close,
  // so this module is event-driven and has no interval to poll on. "alt" is
  // the state name -- notification / none / dnd-* / inhibited-* -- which both
  // picks the glyph below and lands in the CSS class.
  //
  // The count sits in the tooltip rather than the label: swaync sends "0" when
  // nothing is waiting, and a bar that permanently reads "0" is noise.
  "custom/notification": {
    "format": "{icon}",
    "return-type": "json",
    "exec": "swaync-client -swb",
    "escape": true,
    "tooltip": true,
    "format-icons": {
      "notification": "󰂚",
      "none": "󰂚",
      "dnd-notification": "󰂛",
      "dnd-none": "󰂛",
      "inhibited-notification": "󰂚",
      "inhibited-none": "󰂚",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰂛"
    },
    // -sw ("skip wait") everywhere: without it swaync-client blocks waiting for
    // a daemon that may not be running, and the click appears to do nothing.
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "on-click-middle": "swaync-client -C -sw"
  },

  "custom/power": {
    "format": "⏻",
    "tooltip-format": "Session",
    // Lua dispatcher form -- the old "hyprctl dispatch exit" is a syntax error
    // on Hyprland 0.56, so the fallback would have silently done nothing on a
    // system without wlogout.
    "on-click": "wlogout 2>/dev/null || hyprctl dispatch 'hl.dsp.exit()'"
  },

  "tray": {
    "icon-size": 14,
    "spacing": 8
  }
}
