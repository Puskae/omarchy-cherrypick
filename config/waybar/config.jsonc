// Waybar in the Omarchy spirit: flat, quiet, no rounded corners.
// Omarchy 4.0 itself ships `herdr` rather than waybar, so this is an
// interpretation of its look, not a copy of an upstream file.
//
// Colors live in colors.css, regenerated by `omarchy-theme <name>`.
{
  "layer": "top",
  "position": "top",
  "height": 26,
  "spacing": 0,

  "modules-left": ["custom/menu", "hyprland/workspaces", "hyprland/submap"],
  "modules-center": ["clock"],
  "modules-right": [
    "tray",
    "custom/media",
    "custom/brightness",
    "pulseaudio",
    "bluetooth",
    "network",
    "custom/tailscale",
    "cpu",
    "memory",
    "custom/power"
  ],

  // Omarchy puts a logo button at the far left of its bar that opens the menu.
  // That menu is a Quickshell component and isn't here, so this opens walker --
  // the same thing SUPER + SPACE does. walker's own close_when_open makes a
  // second click dismiss it.
  //
  // The glyph is the generic "apps" grid rather than Omarchy's logo: this repo
  // is not affiliated with Omarchy and should not ship its mark. Swap in 󰣇
  // (Arch) or anything else your Nerd Font has.
  "custom/menu": {
    "format": "󰀻",
    "tooltip-format": "Launcher  (SUPER + SPACE)",
    "on-click": "walker"
  },

  "hyprland/workspaces": {
    // No "on-click" here: that's a sway/workspaces option. On
    // hyprland/workspaces waybar would run it as a shell command and
    // swallow the built-in click-to-switch.
    //
    // Note that click-to-switch is broken anyway on waybar 0.15.0 +
    // Hyprland 0.56: waybar hardcodes the pre-Lua "dispatch workspace <id>",
    // which the Lua dispatcher rejects. Fixed upstream in Alexays/Waybar#5013
    // but unreleased as of 0.15.0 -- install waybar-git if you want clicks
    // now. Not fixable from config; see the README. Scroll below works, as
    // do the SUPER+1..9 keys.
    "format": "{id}",
    // Scroll the bar to move between workspaces, matching SUPER+scroll.
    // Hyprland 0.56 dispatchers are Lua: the old "dispatch workspace e+1"
    // string is a syntax error and fails silently from waybar.
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'"
  },

  "hyprland/submap": {
    "format": "{}",
    "tooltip": false
  },

  "clock": {
    // Finnish conventions: 24h clock, Monday-first calendar, week numbers.
    "format": "{:%a %d.%m.  %H:%M}",
    // The calendar hex values below are deliberate, not an oversight: this is
    // Pango markup inside a tooltip, which cannot read colors.css, so these
    // are the one part of the bar a theme switch does not repaint.
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "left",
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b>{}</b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  "cpu": {
    "interval": 5,
    "format": "󰻠 {usage}%",
    "states": { "warning": 70, "critical": 90 },
    "tooltip": true,
    "on-click": "alacritty -e btop"
  },

  "memory": {
    "interval": 5,
    "format": "󰍛 {percentage}%",
    "states": { "warning": 75, "critical": 92 },
    "tooltip-format": "{used:0.1f}G / {total:0.1f}G",
    "on-click": "alacritty -e btop"
  },

  "network": {
    "format-wifi": "󰤨 {essid}",
    "format-ethernet": "󰈀",
    "format-linked": "󰈀 {ifname}",
    "format-disconnected": "󰤭",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
    "tooltip-format-disconnected": "Disconnected",
    // Replaces nm-applet, which was never installed.
    "on-click": "alacritty --title nmtui -e nmtui"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
    "scroll-step": 5,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol"
  },

  "custom/media": {
    "format": "󰎈 {}",
    "escape": true,
    "max-length": 40,
    "interval": 5,
    "exec": "playerctl metadata --format '{{artist}} - {{title}}' 2>/dev/null || true",
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "tooltip": false
  },

  // Monitor brightness over DDC/CI. This is a desktop: there is no
  // /sys/class/backlight and brightnessctl has nothing to talk to, so the
  // control lives on the monitor's I2C bus and ddcutil drives it.
  //
  // A DDC read costs about a second, which is far too slow to poll, so the
  // module is read "once" and then refreshed only when hypr-brightness signals
  // it -- SIGRTMIN+8, matching WAYBAR_SIGNAL in the script.
  //
  // The module disappears on a machine with no DDC/CI monitor, because
  // hypr-brightness exits non-zero and prints nothing.
  "custom/brightness": {
    "format": "󰃟 {}%",
    "exec": "hypr-brightness get",
    "interval": "once",
    "signal": 8,
    "on-scroll-up": "hypr-brightness up",
    "on-scroll-down": "hypr-brightness down",
    // Re-reads from the monitor, for when its own buttons have been used.
    "on-click": "hypr-brightness sync",
    "tooltip": false
  },

  // Built into waybar (it speaks to bluez over D-Bus), so nothing to install
  // beyond bluez/bluez-utils, which are already required for the adapter.
  //
  // blueman is not in the package list -- there is no GUI here by default, so
  // the click falls back to bluetoothctl in a terminal. Install blueman or
  // overskride if you want a real panel and the first branch will win.
  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format": "{controller_alias}\n{status}",
    "tooltip-format-connected": "{controller_alias}\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}  {device_address}",
    "on-click": "blueman-manager 2>/dev/null || alacritty --title bluetooth -e bluetoothctl"
  },

  // Read-only: `tailscale up`/`down` need root unless an operator is set
  // (`sudo tailscale set --operator=$USER`), and a bar button that pops a
  // password prompt on a stray click is worse than one that just reports.
  // Status is cheap -- a few milliseconds -- so 30s polling costs nothing.
  "custom/tailscale": {
    "format": "{}",
    "return-type": "json",
    "interval": 30,
    "exec": "hypr-tailscale",
    "on-click": "alacritty --title tailscale -e sh -c 'hypr-tailscale peers; echo; read -p \"[enter] \"'"
  },

  "custom/power": {
    "format": "⏻",
    "tooltip-format": "Session",
    // Lua dispatcher form -- the old "hyprctl dispatch exit" is a syntax error
    // on Hyprland 0.56, so the fallback would have silently done nothing on a
    // system without wlogout.
    "on-click": "wlogout 2>/dev/null || hyprctl dispatch 'hl.dsp.exit()'"
  },

  "tray": {
    "icon-size": 14,
    "spacing": 8
  }
}
