#!/usr/bin/env python3
"""Tailscale status as a waybar JSON module.

Usage:
  hypr-tailscale          # emit one line of waybar JSON
  hypr-tailscale peers    # print the peer list, for the click action

Read-only on purpose. `tailscale up` / `down` need root unless an operator is
set, and a bar module that pops a password prompt on a stray click is worse
than one that just tells you the truth. To make toggling possible without sudo:

    sudo tailscale set --operator=$USER

Nothing here needs that; it only ever reads.
"""

import json
import subprocess
import sys

ICON = "󰖂"


def status():
    """Parsed `tailscale status --json`, or None when the daemon isn't reachable."""
    try:
        out = subprocess.run(
            ["tailscale", "status", "--json"],
            capture_output=True, text=True, timeout=5,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None

    if out.returncode != 0:
        return None

    try:
        return json.loads(out.stdout)
    except json.JSONDecodeError:
        return None


def bar():
    data = status()

    if data is None:
        # Covers both "tailscaled is not running" and "tailscale is not
        # installed" -- from the bar's point of view they read the same.
        print(json.dumps({"text": ICON, "class": "down", "tooltip": "Tailscale unavailable"}))
        return

    state = data.get("BackendState", "")
    self_node = data.get("Self") or {}
    peers = (data.get("Peer") or {}).values()

    if state != "Running":
        # Stopped is the ordinary "logged in but switched off" state.
        print(json.dumps({
            "text": ICON,
            "class": "down",
            "tooltip": f"Tailscale: {state or 'not running'}",
        }))
        return

    ips = self_node.get("TailscaleIPs") or []
    v4 = next((ip for ip in ips if ":" not in ip), "")
    online = sum(1 for p in peers if p.get("Online"))

    lines = [f"<b>{self_node.get('HostName', 'this machine')}</b>  {v4}",
             f"{online}/{len(list(peers))} peers online"]

    # An exit node is worth surfacing: all traffic is leaving through another
    # machine, which explains a lot of otherwise confusing network behaviour.
    exit_node = next((p for p in peers if p.get("ExitNode")), None)
    if exit_node:
        lines.append(f"exit node: {exit_node.get('HostName', '?')}")

    print(json.dumps({
        "text": ICON,
        "class": "exit-node" if exit_node else "up",
        "tooltip": "\n".join(lines),
    }))


def peer_list():
    data = status()
    if data is None:
        sys.exit("tailscale is not reachable")

    self_node = data.get("Self") or {}
    rows = [(self_node.get("HostName", "?"),
             (self_node.get("TailscaleIPs") or [""])[0],
             "this machine")]

    for peer in sorted((data.get("Peer") or {}).values(),
                       key=lambda p: p.get("HostName", "")):
        rows.append((
            peer.get("HostName", "?"),
            (peer.get("TailscaleIPs") or [""])[0],
            "online" if peer.get("Online") else "offline",
        ))

    width = max(len(name) for name, _, _ in rows)
    for name, ip, note in rows:
        print(f"{name:<{width}}  {ip:<16}  {note}")


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "peers":
        peer_list()
    else:
        bar()
