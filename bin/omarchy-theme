#!/usr/bin/env python3
"""Apply an Omarchy theme to Alacritty + Hyprland, without the Omarchy runtime.

Renders ~/.local/share/omarchy/default/themed/*.tpl against a palette from
~/.local/share/omarchy/themes/<name>/colors.toml.

Usage:
  omarchy-theme            # list themes, mark current
  omarchy-theme <name>     # apply theme
  omarchy-theme --next     # apply the next theme in that list (--prev to go back)
"""

import json
import os
import re
import shutil
import sys
import subprocess

HOME = os.path.expanduser("~")
SHARE = f"{HOME}/.local/share/omarchy"
THEMES = f"{SHARE}/themes"
TPL = f"{SHARE}/default/themed"
CURRENT = f"{HOME}/.local/state/omarchy-theme"

ALACRITTY_OUT = f"{HOME}/.config/alacritty/omarchy-theme.toml"
HYPR_OUT = f"{HOME}/.config/hypr/theme.lua"
WAYBAR_OUT = f"{HOME}/.config/waybar/colors.css"
HYPRPAPER_OUT = f"{HOME}/.config/hypr/hyprpaper.conf"

GTK3_SETTINGS = f"{HOME}/.config/gtk-3.0/settings.ini"
GTK4_SETTINGS = f"{HOME}/.config/gtk-4.0/settings.ini"

BTOP_DIR      = f"{HOME}/.config/btop"
BTOP_OUT      = f"{BTOP_DIR}/themes/omarchy.theme"
BTOP_CONF     = f"{BTOP_DIR}/btop.conf"
NVIM_OUT      = f"{HOME}/.config/nvim/lua/plugins/omarchy-theme.lua"
LAZYVIM_MARK  = f"{HOME}/.local/share/nvim/lazy/LazyVim"
KITTY_OUT     = f"{HOME}/.config/kitty/omarchy-theme.conf"
FOOT_OUT      = f"{HOME}/.config/foot/omarchy-theme.ini"

SWAYNC_DIR    = f"{HOME}/.config/swaync"
SWAYNC_TPL    = f"{SWAYNC_DIR}/style.css.tpl"
SWAYNC_OUT    = f"{SWAYNC_DIR}/style.css"

MAKO_DIR      = f"{HOME}/.config/mako"
MAKO_TPL      = f"{MAKO_DIR}/config.tpl"
MAKO_OUT      = f"{MAKO_DIR}/config"

# VS Code themes itself from an extension, and the Arch build is code-oss, which
# has its own dirs and pulls extensions from Open VSX rather than the Microsoft
# marketplace. Sixteen themes name a marketplace extension in their vscode.json,
# which is why that path is not taken: those publishers may not exist on Open
# VSX at all, and honouring them would put a network install in the middle of a
# theme switch. Every theme gets the generic palette render instead, dropped
# into a local extension that only this script writes.
VSCODE_VARIANTS = (
    # extensions dir              user settings dir
    (f"{HOME}/.vscode-oss/extensions", f"{HOME}/.config/Code - OSS/User"),
    (f"{HOME}/.vscode/extensions",     f"{HOME}/.config/Code/User"),
    (f"{HOME}/.vscode-oss/extensions", f"{HOME}/.config/VSCodium/User"),
)
VSCODE_EXT_NAME = "omarchy-theme"

# VS Code reads a colour theme's JSON once, caches the parsed result with
# "watch": false, and keys that cache on uiTheme + extension id + file path.
# None of those change between palettes, which is what broke the obvious
# design: two fixed labels over two fixed paths meant all 22 palettes shared
# two cache keys, so each label was parsed at most once per VS Code session and
# every apply after that silently kept whichever palette that slot had frozen
# at. Applying nord could leave the editor showing catppuccin-latte -- correct
# JSON on disk, stale colours on screen, no error anywhere.
#
# So every palette gets its own label and its own file. label -> theme id ->
# file content is a fixed mapping, which makes a cached parse correct by
# construction: there is nothing left to invalidate.
#
# The cost is that package.json contributes every theme, and VS Code only
# rescans an extension manifest at startup. A *new* theme appearing under
# ~/.local/share/omarchy/themes therefore needs one VS Code restart before it
# can be selected; applying a theme that was already in the list never does.
VSCODE_LEGACY_FILES = (
    "themes/omarchy-color-theme.json",
    "themes/omarchy-color-theme-2.json",
)

WALKER_DIR    = f"{HOME}/.config/walker"
WALKER_THEME  = f"{WALKER_DIR}/themes/omarchy"
WALKER_TPL    = f"{WALKER_THEME}/style.css.tpl"
WALKER_OUT    = f"{WALKER_THEME}/style.css"
WALKER_CONF   = f"{WALKER_DIR}/config.toml"

# walker ships its stock theme in the system config dir. The rendered theme
# needs the layout XML from it, which is walker's own and version-specific --
# copied at apply time rather than vendored, so it tracks the installed walker.
WALKER_SYSTEM_THEMES = (
    "/etc/xdg/walker/themes/default",
    "/usr/share/walker/themes/default",
)
WALKER_SYSTEM_CONF = "/etc/xdg/walker/config.toml"


def require_share():
    """Omarchy's themes and templates are copied in by hand; say so if they aren't.

    Without this the first run of a fresh checkout dies in os.listdir or open
    with a traceback, which reads like a broken script rather than a missing
    install step.
    """
    for path, what in ((THEMES, "themes"), (TPL, "templates")):
        if not os.path.isdir(path):
            sys.exit(
                f"No Omarchy {what} at {path}\n"
                "Copy them in first -- see 'Omarchy's themes and templates' in the README:\n"
                "  git clone --depth 1 --branch v4.0.1 https://github.com/omacom/omarchy /tmp/omarchy"
            )


def read_palette(theme):
    """Parse the flat key = "value" colors.toml."""
    path = f"{THEMES}/{theme}/colors.toml"
    if not os.path.exists(path):
        sys.exit(f"No such theme: {theme}  (try: omarchy-theme)")

    colors = {}
    with open(path) as fh:
        for line in fh:
            m = re.match(r'^\s*([a-z_]+)\s*=\s*"([^"]*)"\s*$', line)
            if m:
                colors[m.group(1)] = m.group(2)

    # Fallbacks for keys the templates reference but not every theme defines.
    colors.setdefault("selection_background", colors.get("selection", colors.get("muted", "#444444")))
    colors.setdefault("selection_foreground", colors.get("foreground", "#ffffff"))
    colors.setdefault("bright_foreground", colors.get("foreground", "#ffffff"))
    for name in ("red", "green", "yellow", "blue", "magenta", "cyan"):
        colors.setdefault(f"bright_{name}", colors.get(name, "#ffffff"))

    # vscode-theme.json.tpl asks for both of these; colors.toml carries the
    # mode as "mode", and only some palettes define an orange at all.
    colors.setdefault("theme_type", colors.get("mode", "dark"))
    colors.setdefault("orange", colors.get("bright_red", colors.get("yellow", "#d08770")))

    # foot.ini.tpl asks for "purple"; the palettes only define "magenta".
    colors.setdefault("purple", colors.get("magenta", "#ffffff"))
    colors.setdefault("bright_purple", colors.get("bright_magenta", colors["purple"]))

    # swaync composites its backgrounds over alpha, so its CSS wants the bare
    # "r, g, b" triplet inside rgba(...) rather than a hex colour. Derive one
    # for every key, the same way the _strip variants below are derived.
    for key, value in list(colors.items()):
        if re.fullmatch(r"#[0-9a-fA-F]{6}", value):
            colors.setdefault(f"{key}_rgb", ", ".join(
                str(int(value[i:i + 2], 16)) for i in (1, 3, 5)))

    # foot wants bare rrggbb, and upstream expresses that as a "<key>_strip"
    # variable rather than a template filter. Derive one for every colour --
    # without these, every {{ x_strip }} slot is left as literal template text
    # and the generated foot config is unusable.
    for key, value in list(colors.items()):
        if value.startswith("#"):
            colors.setdefault(f"{key}_strip", value.lstrip("#"))

    return colors


def render(tpl_path, colors):
    """Substitute {{ var }} placeholders."""
    if not os.path.exists(tpl_path):
        sys.exit(f"Missing template: {tpl_path}\n"
                 "Recopy default/themed from Omarchy -- see the README.")
    with open(tpl_path) as fh:
        text = fh.read()

    missing = set()

    def sub(match):
        key = match.group(1).strip()
        if key not in colors:
            missing.add(key)
            return match.group(0)
        return colors[key]

    out = re.sub(r"\{\{\s*([a-z_]+)\s*\}\}", sub, text)
    if missing:
        print(f"  note: unresolved template vars: {', '.join(sorted(missing))}")
    return out


def to_rgb(hex_color):
    """#rrggbb -> Hyprland rgb(rrggbb)."""
    return "rgb(%s)" % hex_color.lstrip("#")


def pick_wallpaper(theme):
    """First real background shipped with the theme, if any."""
    bg = f"{THEMES}/{theme}/backgrounds"
    if not os.path.isdir(bg):
        return None

    # "omarchy.webp" is a tiny branding placeholder, not a usable wallpaper.
    files = sorted(
        f for f in os.listdir(bg)
        if f.lower().endswith((".jpg", ".jpeg", ".png", ".webp")) and f != "omarchy.webp"
    )
    return f"{bg}/{files[0]}" if files else None


def write(path, text, header=None):
    """Write a generated file, creating its directory."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as fh:
        if header:
            fh.write(header)
        fh.write(text)


ALACRITTY_CONF = f"{HOME}/.config/alacritty/alacritty.toml"


def alacritty_import_note():
    """Alacritty only reads the generated file if alacritty.toml imports it.

    Nothing here writes alacritty.toml -- that is the user's own config -- so
    the theme is inert until the import line exists. Say so rather than
    reporting success on a terminal whose colors never change.
    """
    try:
        with open(ALACRITTY_CONF) as fh:
            if "omarchy-theme.toml" in fh.read():
                return None
    except OSError:
        pass
    return ("note: add this to " + ALACRITTY_CONF + " or the colors above are unused:\n"
            '        [general]\n'
            '        import = ["~/.config/alacritty/omarchy-theme.toml"]')


def apply_btop(theme, colors):
    """Render btop's theme and point btop.conf at it.

    btop reads its theme once at startup and has no reload signal, so a running
    btop keeps the old colors until it is restarted.
    """
    # Gate on the binary. btop does not create ~/.config/btop until it has been
    # run once, so testing for the directory would silently skip a freshly
    # installed btop -- and write() creates the directory anyway.
    if not shutil.which("btop"):
        return None

    write(BTOP_OUT, render(f"{TPL}/btop.theme.tpl", colors),
          f"# Generated by omarchy-theme from the '{theme}' Omarchy theme.\n"
          "# Do not edit -- rerun `omarchy-theme <name>` instead.\n\n")

    # btop.conf is the user's file; rewrite only the one line that selects a theme.
    if os.path.exists(BTOP_CONF):
        with open(BTOP_CONF) as fh:
            conf = fh.read()
        line = f'color_theme = "{BTOP_OUT}"'
        if re.search(r'^\s*color_theme\s*=.*$', conf, re.M):
            conf = re.sub(r'^\s*color_theme\s*=.*$', line, conf, count=1, flags=re.M)
        else:
            conf = conf.rstrip("\n") + "\n" + line + "\n"
        with open(BTOP_CONF, "w") as fh:
            fh.write(conf)

    return "btop"


def apply_neovim(theme, colors):
    """Install the theme's Neovim colorscheme as a LazyVim plugin spec.

    Most themes ship a hand-picked colorscheme (nord -> nordfox); the rest fall
    back to the generic aether template driven by the palette. Both are LazyVim
    plugin specs, so this is skipped entirely unless LazyVim is installed --
    otherwise it would drop a file nothing ever reads.
    """
    if not os.path.isdir(LAZYVIM_MARK):
        return None

    own = f"{THEMES}/{theme}/neovim.lua"
    if os.path.exists(own):
        with open(own) as fh:
            body = fh.read()
    else:
        body = render(f"{TPL}/neovim.lua.tpl", colors)

    write(NVIM_OUT, body,
          f"-- Generated by omarchy-theme from the '{theme}' Omarchy theme.\n"
          "-- Do not edit -- rerun `omarchy-theme <name>` instead.\n\n")
    return "neovim"


def apply_walker(theme, colors):
    """Render walker's stylesheet from the palette.

    Unlike the other outputs this is not an Omarchy template -- Omarchy has no
    walker template, because its launcher is a Quickshell component. The
    template is this repo's own and lives inside the generated theme directory,
    so `omarchy-theme` renders style.css.tpl to style.css beside it.

    A walker theme is layout XML plus a stylesheet. Only the stylesheet is
    generated; the XML is copied once from the installed walker's stock theme,
    so it stays in step with the walker version rather than being pinned here.
    """
    if not shutil.which("walker"):
        return None

    if not os.path.exists(WALKER_TPL):
        return ("note: no walker template at " + WALKER_TPL + "\n"
                "        copy config/walker/style.css.tpl there to theme the launcher")

    system_theme = next((d for d in WALKER_SYSTEM_THEMES if os.path.isdir(d)), None)

    # The XML is what makes the directory a theme; without it walker has a
    # stylesheet and no widgets to apply it to.
    if not os.path.exists(f"{WALKER_THEME}/layout.xml"):
        if not system_theme:
            return ("note: walker's stock theme was not found in " +
                    " or ".join(WALKER_SYSTEM_THEMES) + "\n"
                    "        cannot build a theme directory without its layout XML")
        os.makedirs(WALKER_THEME, exist_ok=True)
        for entry in os.listdir(system_theme):
            # style.css is generated below; everything else is walker's.
            if entry != "style.css":
                shutil.copy2(f"{system_theme}/{entry}", f"{WALKER_THEME}/{entry}")

    with open(WALKER_TPL) as fh:
        template = fh.read()

    missing = set()

    def sub(match):
        key = match.group(1).strip()
        if key not in colors:
            missing.add(key)
            return match.group(0)
        return colors[key]

    body = re.sub(r"\{\{\s*([a-z_]+)\s*\}\}", sub, template)
    if missing:
        print(f"  note: unresolved walker template vars: {', '.join(sorted(missing))}")

    write(WALKER_OUT, body,
          f"/* Generated by omarchy-theme from the '{theme}' Omarchy theme. */\n"
          "/* Do not edit -- edit style.css.tpl beside this file instead. */\n\n")

    # Point walker at the theme. config.toml is the user's file: create it from
    # the system default if absent, then rewrite only the theme line -- the same
    # treatment btop.conf gets.
    if not os.path.exists(WALKER_CONF) and os.path.exists(WALKER_SYSTEM_CONF):
        os.makedirs(WALKER_DIR, exist_ok=True)
        shutil.copy2(WALKER_SYSTEM_CONF, WALKER_CONF)

    if os.path.exists(WALKER_CONF):
        with open(WALKER_CONF) as fh:
            conf = fh.read()
        if re.search(r'^\s*theme\s*=.*$', conf, re.M):
            conf = re.sub(r'^\s*theme\s*=.*$', 'theme = "omarchy"', conf, count=1, flags=re.M)
        else:
            conf = 'theme = "omarchy"\n' + conf
        with open(WALKER_CONF, "w") as fh:
            fh.write(conf)

    return "walker"


def apply_swaync(theme, colors):
    """Render swaync's stylesheet -- the palette only.

    swaync loads /etc/xdg/swaync/style.css first and ~/.config/swaync/style.css
    on top of it, so the generated file only has to redefine the :root colour
    variables; the 500+ layout rules stay upstream's and track the installed
    version. (Its log says so plainly: two "Loading CSS" lines, and both name
    the system sheet when there is no user one.)

    config.json is not touched: that one is the user's, copied in once at
    install time, and nothing in it is colour.
    """
    if not shutil.which("swaync"):
        return None

    if not os.path.exists(SWAYNC_TPL):
        return ("note: no swaync template at " + SWAYNC_TPL + "\n"
                "        copy config/swaync/style.css.tpl there to theme the panel")

    write(SWAYNC_OUT, render(SWAYNC_TPL, colors),
          f"/* Generated by omarchy-theme from the '{theme}' Omarchy theme. */\n"
          "/* Do not edit -- edit style.css.tpl beside this file instead. */\n"
          "/* Layered over /etc/xdg/swaync/style.css, which swaync loads first. */\n\n")
    return "swaync"


def reload_swaync():
    """swaync re-reads its CSS on demand; no restart, so nothing is lost.

    Gated on swaync running, like reload_mako and restart_walker. -sw already
    stops the client blocking on a daemon that isn't there, but it still exits
    0, which would have this report a reload that never happened.
    """
    if subprocess.run(["pgrep", "-x", "swaync"],
                      stdout=subprocess.DEVNULL).returncode != 0:
        return False

    return subprocess.run(["swaync-client", "--reload-css", "-sw"],
                          stdout=subprocess.DEVNULL,
                          stderr=subprocess.DEVNULL).returncode == 0


def apply_mako(theme, colors):
    """Render mako's config from the palette.

    Like walker, this is not an upstream Omarchy template -- Omarchy's
    notifications are a Quickshell component -- so config.tpl is this repo's
    own and lives beside the generated file.

    The whole config is generated rather than a colors-only fragment pulled in
    with mako's `include`, because a missing include is fatal: mako refuses to
    start on it, and a notification daemon that never came up looks like
    nothing at all rather than an error.
    """
    if not shutil.which("mako"):
        return None

    if not os.path.exists(MAKO_TPL):
        return ("note: no mako template at " + MAKO_TPL + "\n"
                "        copy config/mako/config.tpl there to theme notifications")

    write(MAKO_OUT, render(MAKO_TPL, colors),
          f"# Generated by omarchy-theme from the '{theme}' Omarchy theme.\n"
          "# Do not edit -- edit config.tpl beside this file instead.\n\n")
    return "mako"


def reload_mako():
    """mako re-reads its config on demand, so no restart and no lost history.

    Gated on mako actually running, the same way restart_walker is. mako stays
    installed here as the fallback daemon while swaync is the one in use, so
    without this check every theme change fires makoctl at a dead daemon --
    harmless, but it reports a reload that did not happen.
    """
    if subprocess.run(["pgrep", "-x", "mako"],
                      stdout=subprocess.DEVNULL).returncode != 0:
        return False

    return subprocess.run(["makoctl", "reload"],
                          stdout=subprocess.DEVNULL,
                          stderr=subprocess.DEVNULL).returncode == 0


def restart_walker():
    """walker reads its theme at startup, so the service has to come back.

    Only restarts a walker that is already running as the gapplication service:
    starting one here on a machine that does not autostart it would leave a
    stray daemon behind.
    """
    running = subprocess.run(["pgrep", "-x", "walker"], stdout=subprocess.DEVNULL)
    if running.returncode != 0:
        return False

    subprocess.run(["pkill", "-x", "walker"], stderr=subprocess.DEVNULL)
    subprocess.Popen(["walker", "--gapplication-service"],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)
    return True


def _set_gtk_setting(path, key, value):
    """Rewrite one key=value line in a GTK settings.ini, in place.

    Same idiom as apply_btop's color_theme line: settings.ini is the user's
    file -- GTK itself writes font/cursor/toolbar prefs into it -- so only the
    keys this script owns get touched.
    """
    if os.path.exists(path):
        with open(path) as fh:
            conf = fh.read()
    else:
        conf = "[Settings]\n"

    line = f"{key}={value}"
    pattern = rf"^\s*{re.escape(key)}\s*=.*$"
    if re.search(pattern, conf, re.M):
        conf = re.sub(pattern, line, conf, count=1, flags=re.M)
    else:
        conf = conf.rstrip("\n") + "\n" + line + "\n"

    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as fh:
        fh.write(conf)


def apply_gtk(theme, colors):
    """Point Thunar (and any other GTK3/4 app) at the theme's icon set and
    light/dark mode.

    Gated on thunar rather than a config directory existing: GTK doesn't
    create ~/.config/gtk-3.0 until something reads it, the same reason
    apply_btop gates on the binary instead of ~/.config/btop.

    Every Omarchy theme names a matching Yaru icon variant in icons.theme, but
    Yaru is AUR-only and isn't installed here -- pointing GTK at an icon theme
    that doesn't exist on disk renders every icon as a blank box, so this
    falls back to Adwaita (always present) when the named variant is missing.
    """
    if not shutil.which("thunar"):
        return None

    icon_theme = "Adwaita"
    icons_file = f"{THEMES}/{theme}/icons.theme"
    if os.path.exists(icons_file):
        with open(icons_file) as fh:
            wanted = fh.read().strip()
        if wanted and os.path.isdir(f"/usr/share/icons/{wanted}"):
            icon_theme = wanted

    dark = "1" if colors.get("theme_type", "dark") == "dark" else "0"

    for settings_path in (GTK3_SETTINGS, GTK4_SETTINGS):
        _set_gtk_setting(settings_path, "gtk-icon-theme-name", icon_theme)
        _set_gtk_setting(settings_path, "gtk-application-prefer-dark-theme", dark)

    return "gtk (thunar)"


def apply_terminals(theme, colors):
    """kitty and foot, for whoever uses them alongside Alacritty."""
    done = []
    for name, tpl, out in (("kitty", "kitty.conf.tpl", KITTY_OUT),
                           ("foot", "foot.ini.tpl", FOOT_OUT)):
        if not shutil.which(name):
            continue
        comment = "#"
        write(out, render(f"{TPL}/{tpl}", colors),
              f"{comment} Generated by omarchy-theme from the '{theme}' Omarchy theme.\n"
              f"{comment} Do not edit -- rerun `omarchy-theme <name>` instead.\n"
              f"{comment} Include this from your own config.\n\n")
        done.append(name)
    return done


def vscode_dirs():
    """The extensions + settings dirs of whichever VS Code build is installed."""
    if not (shutil.which("code") or shutil.which("code-oss") or shutil.which("codium")):
        return None
    for ext_dir, user_dir in VSCODE_VARIANTS:
        if os.path.isdir(user_dir):
            return ext_dir, user_dir
    return None


def vscode_label(theme):
    """The name VS Code shows in its picker, and the value in settings.json."""
    return f"Omarchy ({theme})"


def vscode_rel(theme):
    """This palette's theme file, relative to the extension directory."""
    return f"themes/omarchy-{theme}-color-theme.json"


def theme_mode(theme):
    """light/dark for one theme, without parsing its whole palette.

    Only uiTheme needs this, and it needs it for every installed theme on every
    apply -- 22 files whose first line is the answer.
    """
    try:
        with open(f"{THEMES}/{theme}/colors.toml") as fh:
            for line in fh:
                m = re.match(r'^\s*mode\s*=\s*"([^"]*)"\s*$', line)
                if m:
                    return m.group(1)
    except OSError:
        pass
    return "dark"


def vscode_select_theme(settings_path, label):
    """Point workbench.colorTheme at this palette's label.

    settings.json is the user's file and is jsonc -- comments and trailing
    commas are legal there and json.load chokes on them. A file we cannot parse
    is left completely alone and reported, because half-rewriting someone's
    editor settings is worse than not theming the editor.

    Re-applying the theme that is already selected writes the same value and so
    does not make VS Code reload. That is right for a palette that has not
    changed, and the one case it gets wrong -- hand-editing a colors.toml and
    re-applying the same theme -- wants a window reload anyway.
    """
    existing = "{}"
    if os.path.exists(settings_path):
        with open(settings_path) as fh:
            existing = fh.read()

    try:
        settings = json.loads(existing) if existing.strip() else {}
    except json.JSONDecodeError:
        return ("note: VS Code settings.json has comments or is malformed -- "
                f'set "workbench.colorTheme": "{label}" in it by hand')

    settings["workbench.colorTheme"] = label

    os.makedirs(os.path.dirname(settings_path), exist_ok=True)
    with open(settings_path, "w") as fh:
        json.dump(settings, fh, indent=4)
        fh.write("\n")
    return None


def apply_vscode(theme, colors):
    """Render the palette into a local extension VS Code loads as a theme."""
    dirs = vscode_dirs()
    if not dirs:
        return None
    ext_dir, user_dir = dirs

    tpl = f"{TPL}/vscode-theme.json.tpl"
    if not os.path.exists(tpl):
        return "note: vscode-theme.json.tpl is missing -- VS Code left unthemed"

    ext = f"{ext_dir}/{VSCODE_EXT_NAME}"

    # Only the theme being applied is rendered. The others are contributed by
    # package.json whether or not their file exists yet, and a file only has to
    # be there when its label is selected -- which is what this line just did
    # for the one label about to be written into settings.json.
    write(f"{ext}/{vscode_rel(theme)}", render(tpl, colors))

    # uiTheme decides which built-in defaults show through for anything the
    # theme does not colour, so it follows each palette's own light/dark mode --
    # five of the themes are light.
    contributions = [
        {
            "label": vscode_label(name),
            "uiTheme": "vs" if theme_mode(name) == "light" else "vs-dark",
            "path": f"./{vscode_rel(name)}",
        }
        for name in theme_names()
    ]

    # A manifest VS Code has already scanned is only re-read at startup, so a
    # changed theme list is worth saying out loud rather than leaving the user
    # with a label their editor does not recognise.
    pkg = f"{ext}/package.json"
    was = []
    try:
        with open(pkg) as fh:
            was = [t.get("label") for t in json.load(fh)["contributes"]["themes"]]
    except (OSError, ValueError, KeyError, TypeError):
        pass

    write(pkg, json.dumps({
        "name": VSCODE_EXT_NAME,
        "displayName": "Omarchy Theme",
        "description": "Generated by omarchy-theme from the current Omarchy palette.",
        "version": "1.0.0",
        "publisher": "local",
        "engines": {"vscode": "^1.70.0"},
        "categories": ["Themes"],
        "contributes": {"themes": contributions},
    }, indent=2) + "\n")

    # The two shared files the old scheme rotated between. Left in place they
    # are dead weight that no label points at any more.
    for rel in VSCODE_LEGACY_FILES:
        try:
            os.remove(f"{ext}/{rel}")
        except OSError:
            pass

    note = vscode_select_theme(f"{user_dir}/settings.json", vscode_label(theme))
    if note:
        return note
    if was != [c["label"] for c in contributions]:
        return ("note: VS Code's theme list changed -- restart VS Code once, "
                "it only rescans extension manifests at startup")
    return "vscode"


def apply(theme):
    require_share()
    colors = read_palette(theme)
    written = []
    notes = []

    # --- Alacritty: render the stock Omarchy template ---
    # Skipped when Alacritty is not installed, like the outputs below.
    if shutil.which("alacritty"):
        write(ALACRITTY_OUT, render(f"{TPL}/alacritty.toml.tpl", colors),
              f"# Generated by omarchy-theme from the '{theme}' Omarchy theme.\n"
              "# Do not edit -- rerun `omarchy-theme <name>` instead.\n"
              "# Your own settings live in alacritty.toml.\n\n")
        written.append(ALACRITTY_OUT)
        notes.append(alacritty_import_note())

    # --- Hyprland: border colors from the same palette ---
    accent = to_rgb(colors.get("accent", colors.get("blue", "#81a1c1")))
    os.makedirs(os.path.dirname(HYPR_OUT), exist_ok=True)
    with open(HYPR_OUT, "w") as fh:
        fh.write(
            f"-- Generated by omarchy-theme from the '{theme}' Omarchy theme.\n"
            "-- Do not edit -- rerun `omarchy-theme <name>` instead.\n\n"
            "hl.config({\n"
            "  general = {\n"
            "    col = {\n"
            f'      active_border = "{accent}",\n'
            '      inactive_border = "rgba(595959aa)",\n'
            "    },\n"
            "  },\n\n"
            "  group = {\n"
            "    col = {\n"
            f'      border_active = "{accent}",\n'
            '      border_inactive = "rgba(595959aa)",\n'
            "    },\n"
            "  },\n"
            "})\n"
        )
    written.append(HYPR_OUT)

    # --- Waybar: @define-color block consumed by style.css ---
    # Gated on the binary, like everything else: gating on ~/.config/waybar
    # existing meant a freshly installed waybar was skipped in silence, and
    # style.css then @imported a colors.css that was never written.
    if shutil.which("waybar"):
        os.makedirs(os.path.dirname(WAYBAR_OUT), exist_ok=True)
        with open(WAYBAR_OUT, "w") as fh:
            fh.write(
                f"/* Generated by omarchy-theme from the '{theme}' Omarchy theme. */\n"
                "/* Do not edit -- rerun `omarchy-theme <name>` instead. */\n\n"
            )
            for var, key in (
                ("bg", "background"), ("fg", "foreground"), ("accent", "accent"),
                ("muted", "muted"), ("red", "red"), ("green", "green"),
                ("yellow", "yellow"), ("blue", "blue"), ("magenta", "magenta"),
                ("cyan", "cyan"),
            ):
                fh.write(f"@define-color {var} {colors.get(key, '#888888')};\n")
        written.append(WAYBAR_OUT)

    # --- Wallpaper: first background shipped with the theme ---
    wallpaper = pick_wallpaper(theme)
    if wallpaper:
        # hyprpaper 0.8 replaced the flat `preload =` / `wallpaper = ,path` keys
        # with a `wallpaper { }` block. The old form still parses without any
        # error and then silently creates no wallpaper at all -- the only hint
        # is "Monitor <name> has no target" in hyprpaper's own output.
        with open(HYPRPAPER_OUT, "w") as fh:
            fh.write(
                "# Managed by `omarchy-theme <name>` -- it rewrites the path below\n"
                "# to the selected theme's wallpaper. Edit the theme, not this file.\n"
                "wallpaper {\n"
                "    monitor =\n"
                f"    path = {wallpaper}\n"
                "}\n"
                "splash = false\n"
                "ipc = on\n"
            )
        written.append(HYPRPAPER_OUT)

    # --- Apps beyond the core four, each skipped if not installed ---
    extras = []
    for fn in (apply_btop, apply_neovim, apply_walker, apply_swaync, apply_mako,
               apply_vscode, apply_gtk):
        got = fn(theme, colors)
        if got:
            # apply_walker, apply_swaync and apply_mako return a note
            # instead of a name when the app is there but its template is not.
            (notes if got.startswith("note:") else extras).append(got)
    extras += apply_terminals(theme, colors)

    os.makedirs(os.path.dirname(CURRENT), exist_ok=True)
    with open(CURRENT, "w") as fh:
        fh.write(theme + "\n")

    print(f"Applied theme: {theme}")
    for path in written:
        print(f"  {path}")
    if extras:
        print(f"  also themed: {', '.join(extras)}")
    for note in notes:
        if note:
            print(f"  {note}")

    # Alacritty picks it up via live_config_reload; Hyprland needs a nudge.
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        subprocess.run(["hyprctl", "reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print("  hyprctl reload: done")

        # Waybar has no reload signal for CSS; SIGUSR2 restarts it in place.
        if subprocess.run(["pkill", "-USR2", "waybar"],
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
            print("  waybar reloaded")

        if wallpaper:
            # hyprpaper only re-reads its config on restart. Prefer restarting
            # its systemd unit over a raw pkill+respawn: killing the unit's
            # tracked process out from under it races Restart=on-failure and
            # can leave the unit "inactive (dead)" with an orphan hyprpaper
            # process actually holding the wallpaper -- systemd then thinks
            # nothing is running. Raw pkill+respawn is the fallback for a
            # session where hyprpaper was never brought up as a unit at all
            # (e.g. non-uwsm Hyprland with no session manager).
            unit_active = subprocess.run(
                ["systemctl", "--user", "is-active", "--quiet", "hyprpaper.service"]
            ).returncode == 0
            if unit_active:
                subprocess.run(["systemctl", "--user", "restart", "hyprpaper.service"],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                print(f"  wallpaper: {os.path.basename(wallpaper)}")
            elif subprocess.run(["pgrep", "-x", "hyprpaper"],
                                stdout=subprocess.DEVNULL).returncode == 0:
                subprocess.run(["pkill", "-x", "hyprpaper"], stderr=subprocess.DEVNULL)
                subprocess.Popen(["hyprpaper"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                 start_new_session=True)
                print(f"  wallpaper: {os.path.basename(wallpaper)}")

        if "walker" in extras and restart_walker():
            print("  walker restarted")

        if "swaync" in extras and reload_swaync():
            print("  swaync reloaded")

        if "mako" in extras and reload_mako():
            print("  mako reloaded")

        # Nothing to say about VS Code any more: it does not watch theme files,
        # it watches settings.json, and every palette now has a label of its
        # own -- so pointing the setting at that label recolours the editor in
        # place. The only case that needs a restart is a theme the manifest has
        # never listed, and apply_vscode returns a note for that instead.
        if "btop" in extras:
            print("  note: restart btop to pick up its new colors")
        if "neovim" in extras:
            print("  note: restart nvim; :Lazy sync if the colorscheme is new")


def theme_names():
    require_share()
    return sorted(t for t in os.listdir(THEMES) if os.path.isdir(f"{THEMES}/{t}"))


def current_theme():
    if os.path.exists(CURRENT):
        with open(CURRENT) as fh:
            return fh.read().strip()
    return ""


def cycle(step):
    """Apply the next (or previous) theme in the same order `omarchy-theme` lists.

    For flipping through the set from a keybind: wraps at both ends, and starts
    from the first theme when the state file names something no longer there.
    """
    themes = theme_names()
    if not themes:
        sys.exit(f"No themes in {THEMES}")

    try:
        index = themes.index(current_theme())
    except ValueError:
        index = -1 if step > 0 else 0

    theme = themes[(index + step) % len(themes)]
    apply(theme)

    # Cycling is a keybind, where stdout goes nowhere -- say which one landed.
    if shutil.which("notify-send"):
        subprocess.run(
            ["notify-send", "-a", "omarchy-theme", "-t", "1500",
             "-h", "string:x-canonical-private-synchronous:omarchy-theme",
             f"Theme: {theme}", f"{themes.index(theme) + 1} of {len(themes)}"],
            stderr=subprocess.DEVNULL)


def list_themes():
    current = current_theme()
    print("Omarchy themes:\n")
    for theme in theme_names():
        print(f"  {'*' if theme == current else ' '} {theme}")
    print("\nApply with: omarchy-theme <name>")


if __name__ == "__main__":
    arg = sys.argv[1] if len(sys.argv) > 1 else None
    if arg is None:
        list_themes()
    elif arg in ("-h", "--help"):
        print(__doc__.strip())
    elif arg in ("-n", "--next"):
        cycle(1)
    elif arg in ("-p", "--prev", "--previous"):
        cycle(-1)
    else:
        apply(arg)
