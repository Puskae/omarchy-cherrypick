#!/bin/sh
# Print every described Hyprland bind as "KEYS<TAB>description".
hyprctl binds | awk '
function keys(  s) {
  s = ""
  if (and(mod, 64)) s = s "SUPER + "
  if (and(mod, 4))  s = s "CTRL + "
  if (and(mod, 8))  s = s "ALT + "
  if (and(mod, 1))  s = s "SHIFT + "
  return s (key != "" ? key : "code:" code)
}
/^bindd?$/            { mod = 0; key = ""; code = ""; desc = "" }
/^\tmodmask:/         { mod  = $2 }
/^\tkey:/             { key  = $2 }
/^\tkeycode:/         { code = $2 }
/^\tdescription:/     { sub(/^\tdescription: /, ""); desc = $0 }
/^\tdispatcher:/      { if (desc != "") printf "%-34s %s\n", keys(), desc }
' | sort -u | less -FX
