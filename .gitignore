# Generated by omarchy-theme -- machine-specific, don't commit
hypr/theme.lua
hypr/hyprpaper.conf

# config/waybar/colors.css is NOT ignored, even though omarchy-theme
# regenerates it: style.css @imports it, and GTK discards the whole stylesheet
# when an @import is missing. The committed copy is a neutral fallback so the
# bar is styled before the first `omarchy-theme <name>` run.

# Python bytecode, if the script is run from the checkout
__pycache__/
*.pyc

# Editor / OS noise
*.swp
*~
.DS_Store

# Local snapshots
*.bak
*.prewalkerfix
